# SPA fallback — serve index.html for all non-file, non-api paths
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Allow direct access to existing files
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # API requests — route to api/
  RewriteRule ^api/(.*)$ api/$1 [L]

  # SPA fallback — serve the built index.html
  RewriteRule ^(.*)$ dist/index.html [L,QSA]
</IfModule>

# Security headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
</IfModule>

# Cache — immutable for hashed assets
<FilesMatch "\.(js|css|woff2|png|webp|svg)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
<FilesMatch "\.html$">
  Header set Cache-Control "no-cache, no-store, must-revalidate"
</FilesMatch>